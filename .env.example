APP_NAME="Flight Aggregator"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=flight_aggregator
DB_USERNAME=laravel
DB_PASSWORD=secret

CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis

SESSION_DRIVER=redis

# Cache
FLIGHT_CACHE_TTL_SECONDS=300
SEARCH_RATE_LIMIT=60

# Suppliers
SUPPLIER_SEPEHR_BASE_URL=https://SepehrApiTest.ir/api/Partners/Flight/Availability/V16/SearchByRouteAndDate
SUPPLIER_SEPEHR_POLL_INTERVAL=20

SUPPLIER_ALIBABA_BASE_URL=https://charter.alibaba.ir/api/Partners/Flight/Availability/V16/SearchByRouteAndDate
SUPPLIER_ALIBABA_POLL_INTERVAL=10

SUPPLIER_SEPIDPARVAZ_BASE_URL=https://sepidparvaz.ir/api/Partners/Flight/Availability/V16/SearchByRouteAndDate
SUPPLIER_SEPIDPARVAZ_POLL_INTERVAL=15

SUPPLIER_RAHBAL_BASE_URL=https://sbook.rahbal.com/api/Partners/Flight/Availability/V16/SearchByRouteAndDate
SUPPLIER_RAHBAL_POLL_INTERVAL=30

SUPPLIER_MEHRAGIN_BASE_URL=https://mehraginseir.ir/api/Partners/Flight/Availability/V16/SearchByRouteAndDate
SUPPLIER_MEHRAGIN_POLL_INTERVAL=25

# Swagger
L5_SWAGGER_GENERATE_ALWAYS=true
